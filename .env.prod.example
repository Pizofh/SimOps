# App
SIMOPS_ENVIRONMENT=production
SIMOPS_LOG_LEVEL=INFO

# Dominio público
PUBLIC_FRONTEND_URL=https://simops.tudominio.com
PUBLIC_API_URL=https://api.simops.tudominio.com
SIMOPS_API_BASE_URL=https://api.simops.tudominio.com

# Backend security
SIMOPS_CORS_ORIGINS=https://simops.tudominio.com
SIMOPS_ALLOWED_HOSTS=simops.tudominio.com,api.simops.tudominio.com,localhost,127.0.0.1,backend,testserver

# Postgres
POSTGRES_DB=simops
POSTGRES_USER=simops
POSTGRES_PASSWORD=CAMBIA_ESTO_CON_OPENSSL_RAND_HEX_32

# Bind SOLO a localhost en EC2
POSTGRES_PORT=127.0.0.1:5434
BACKEND_PORT=127.0.0.1:8000
FRONTEND_PORT=127.0.0.1:8080
PROMETHEUS_PORT=127.0.0.1:9090
LOKI_PORT=127.0.0.1:3100
GRAFANA_PORT=127.0.0.1:3000

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CAMBIA_ESTO_TAMBIEN_GENIO

# Simulator
SIMULATOR_INTERVAL_SECONDS=5
SIMULATOR_FAILURE_RATE=0.25
SIMULATOR_BURST_RATE=0.15
SIMULATOR_BURST_MIN_SIZE=3
SIMULATOR_BURST_MAX_SIZE=6
SIMULATOR_SERVICE_NAMES=payments-api,auth-api,inventory-worker
SIMULATOR_ENVIRONMENT=production-lab
SIMULATOR_MAX_RANDOM_DELAY_MS=250